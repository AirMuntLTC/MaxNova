<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp"
    android:background="#F0121420">

    <ImageButton android:id="@+id/widget_chat" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:src="@drawable/ic_chat" android:contentDescription="MaxNova chat" android:background="@android:color/transparent" />
    <ImageButton android:id="@+id/widget_media" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:src="@drawable/ic_media" android:contentDescription="MaxNova media" android:background="@android:color/transparent" />
    <ImageButton android:id="@+id/widget_voice" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:src="@drawable/ic_mic" android:contentDescription="MaxNova voice" android:background="@android:color/transparent" />
</LinearLayout>
